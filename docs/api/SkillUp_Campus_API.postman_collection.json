{
  "info": {
    "name": "SkillUp Campus API - Semana 4",
    "description": "Colección oficial de endpoints de Autenticación (JWT) y CRUD de Cursos.",
    "schema": "https://getpostman.com"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "token", "value": "PEGA_AQUI_TU_TOKEN_JWT" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nuevo Estudiante\",\n  \"email\": \"estudiante@skillup.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login User (JWT)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rodolfo@skillup.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Get All Courses (Público)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/courses"
          }
        },
        {
          "name": "Get Course by ID (Público)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/courses/1"
          }
        },
        {
          "name": "Create Course (Solo Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Introducción a React y Vite\",\n  \"description\": \"Construye interfaces modernas desde cero.\",\n  \"instructor\": \"Prof. Laura Gómez\",\n  \"duration\": \"6 semanas\",\n  \"level\": \"Inicial\"\n}"
            },
            "url": "{{baseUrl}}/api/courses"
          }
        },
        {
          "name": "Update Course (Solo Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"level\": \"Intermedio\",\n  \"duration\": \"8 semanas\"\n}"
            },
            "url": "{{baseUrl}}/api/courses/1"
          }
        },
        {
          "name": "Delete Course (Solo Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/courses/1"
          }
        }
      ]
    }
  ]
}
